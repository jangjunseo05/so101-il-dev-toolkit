# Runtime / machine-specific data — never shared between teammates
data/
checkpoints/
checkpoints_bottle/
logs/
state/
train_runs/
*.log

# Per-teammate local settings (COM port, calibration id, dataset paths)
config/local_settings.json

# Physical-arm-specific servo calibration — copying this to a different
# physical arm silently applies wrong homing offsets/joint ranges. Each
# teammate generates their own via docs/REAL_LEADER_SETUP.md step 4.
config/full_arm_calibration_leader.json
config/full_arm_calibration_follower.json

# Knowledge-graph tooling artifacts (irrelevant to teammates)
graphify-out/

# Dashboard screenshot verification tooling (node_modules + scratch PNGs) --
# see .claude/skills/dashboard-screenshot/SKILL.md. Kept out of git since
# it's a dev-only helper, not project source; each teammate who wants it
# runs the one-time npm install themselves.
.tools/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/

# Streamlit local overrides / secrets, if ever created
.streamlit/secrets.toml

# Editor/OS cruft
.vscode/
.idea/
Thumbs.db
.DS_Store

# Claude Code local session/tooling state -- but NOT .claude/skills/, which
# holds project skills (e.g. dashboard-screenshot) meant to be shared with
# teammates via clone, same as any other project doc.
.claude/scheduled_tasks.lock
